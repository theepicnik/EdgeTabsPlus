{
  "manifest_version": 3,
  "name": "EdgeTabsPlus",
  "version": "1.1.0",
  "description": "Automatically organizes browser tabs into custom color-coded groups based on domain and wildcard URL patterns in Microsoft Edge.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "EdgeTabsPlus Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}